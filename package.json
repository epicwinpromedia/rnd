    "test": "node --test test/worker.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@cloudflare/workers-types": "^5.20261121.1",
    "cf": "^1.0.0-rc.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
