{
  "name": "rnd-doc-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical Multi-Format Publishing Archive (rnd.epicwinpromedia.com) — Cloudflare Workers + R2 + Browser Run + Workflows",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
